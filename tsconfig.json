{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "useDefineForClassFields": true,

    /* Runs through vue-tsc, not tsc: the modules to type-check are the Vue
       twin's (`*.vue` + `js/*.ts`), so there is no parser/JSX config here. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["js/*"],
      "@views/*": ["views/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,

    "types": ["vite/client", "node"]
  },
  "include": ["js", "views", "vite.config.ts"]
}
