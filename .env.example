# Starter environment.
#
# Copy to .env and adjust. Never commit .env — it is gitignored.

# --- Application ---
APP_NAME=Starter
APP_ENV=local
DEBUG=true
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=info
# Signs sessions and CSRF tokens. `make setup` replaces this placeholder with
# a fresh key; generate one per environment with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-me

# --- Database ---
DATABASE_URL=sqlite://storage/starter.db
DB_POOL_SIZE=5
DB_ECHO=false

# --- Sessions ---
SESSION_COOKIE_NAME=session_id
SESSION_LIFETIME=86400

# --- Front end ---
# true  — load JavaScript from the Vite dev server. Run `npm run dev` too.
# false — load the built files named in static/build/.vite/manifest.json.
#         Requires `npm run build`; without it the first page render fails
#         with FileNotFoundError on the manifest.
VITE_DEV=true
VITE_DEV_SERVER=http://localhost:5173

# Sent to the client as the asset version. When it changes, an Inertia visit
# gets a 409 and the client does a full reload — which is what stops a stale
# bundle from talking to a new API. In production set it per build; a commit
# SHA works.
ASSET_VERSION=dev

# --- Security ---
# The Vite dev server's origin. Not needed once VITE_DEV=false.
CORS_ALLOW_ORIGINS=http://localhost:5173
